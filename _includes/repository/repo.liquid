{% comment %}
  Static repo card. Replaces github-readme-stats placeholders which often 503
  / rate-limit. Accepts either:
    - a plain string "owner/repo" (legacy entries), or
    - an object with keys: repo, title, description, paper, tags.
{% endcomment %}

{% assign r = include.repository %}
{% if r.repo %}
  {% assign repo_path = r.repo %}
  {% assign repo_title = r.title %}
  {% assign repo_desc = r.description %}
  {% assign repo_paper = r.paper %}
  {% assign repo_tags = r.tags %}
{% else %}
  {% assign repo_path = r %}
{% endif %}

{% assign parts = repo_path | split: '/' %}
{% assign owner = parts[0] %}
{% assign name = parts[1] %}
{% if repo_title == null or repo_title == '' %}
  {% assign repo_title = name %}
{% endif %}

<div class="repo-card p-3">
  <a class="repo-card-link" href="https://github.com/{{ repo_path }}" target="_blank" rel="noopener">
    <div class="repo-card-header">
      <i class="fa-brands fa-github repo-card-icon" aria-hidden="true"></i>
      <div class="repo-card-titles">
        <div class="repo-card-owner">{{ owner }}</div>
        <div class="repo-card-name">{{ repo_title }}</div>
      </div>
    </div>
    {% if repo_desc %}
      <p class="repo-card-desc">{{ repo_desc }}</p>
    {% endif %}
    <div class="repo-card-meta">
      {% if repo_paper %}
        <span class="repo-card-paper">{{ repo_paper }}</span>
      {% endif %}
      {% if repo_tags %}
        <span class="repo-card-tags">
          {% for tag in repo_tags %}
            <span class="repo-card-tag">{{ tag }}</span>
          {% endfor %}
        </span>
      {% endif %}
    </div>
  </a>
</div>
